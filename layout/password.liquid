<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9HR1RXNF60"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9HR1RXNF60');
    </script>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_button }}">
    {% render 'meta-description' %}

    <link rel="canonical" href="{{ canonical_url }}">

    {% if settings.favicon != blank %}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {% endif %}

    <title>
      {{ shop.name }}
      &ndash;
      {{ 'general.password_page.opening_soon' | t }}
    </title>

    {% render 'theme-setup' %}
    {% render 'theme-setting-vars' %}
    {%- render 'theme-globals' -%}

    {% render 'social-meta-tags' %}

    {{ content_for_header }}
    {{ 'template-password.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-password">
    {% if settings.enable_page_transitions %}
      {% render 'page-transition-overlay' %}
    {% endif %}

    <div class="theme-editor-scroll-offset"></div>

    <div class="page">
      {% section 'password-header' %}
      <main id="main" class="main">
        {{ content_for_layout }}
      </main>

      {% render 'modal' %}
      {% render 'store-availability-drawer' %}
      {% render 'flash-alert' %}
    </div>
  </body>
</html>
