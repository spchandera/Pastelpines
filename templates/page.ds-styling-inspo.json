{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"enable_animation":true,"content_width":"custom","custom_content_width":700}},"rich_text_E4dMxL":{"type":"rich-text","blocks":{"heading_AVLLB3":{"type":"heading","settings":{"title":"Styling Inspiration","heading_tag":"h1","heading_font_class":"fs-heading-1-base"}},"text_7ANGAi":{"type":"text","settings":{"text":"<p>Shells and driftwood are incredibly versatile, and how they’re styled can make all the difference in-store. From eye catching displays to simple, functional uses, a few thoughtful styling choices can help your customers imagine how shells and driftwood might work in their own spaces. Below are easy, adaptable styling ideas you can use in your store and share with customers, whether they’re decorating a home, setting a table, or planning a special event.<br\/><\/p>","text_font_class":"fs-body-100"}}},"block_order":["heading_AVLLB3","text_7ANGAi"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_center","enable_animation":true,"divider_style":"none","section_padding":"section--vertical-padding-top-bottom","content_width":"full","custom_content_width":700,"background_color":"#fefaf1","text_color":"#5c5451","cutsom_class":"inspo-rich-text"}},"multi_column_Qg93ce":{"type":"multi-column","blocks":{"image_column_3bnrKm":{"type":"image_column","settings":{"image":"shopify:\/\/shop_images\/2025_07_07_-_Pastel_Pines_035_1.jpg","image_width":100,"aspect_ratio":"natural","enable_image_crop_circle":false,"focal_point":"image_presentation","image_position":"above_text","image_link":"","small_caption":"","accent":"","heading":"","heading_tag":"h3","heading_font_class":"fs-heading-5-base","text":"","text_font_class":"fs-body-100","text_max_width":100,"link":"","link_text":"","button_style":"btn--primary"}},"image_column_tBPiyP":{"type":"image_column","settings":{"image":"shopify:\/\/shop_images\/Group_33.jpg","image_width":100,"aspect_ratio":"natural","enable_image_crop_circle"