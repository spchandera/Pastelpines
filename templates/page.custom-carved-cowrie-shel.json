{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"enable_animation":true,"content_width":"custom","custom_content_width":700}},"rich_text_NVTmDP":{"type":"rich-text","blocks":{"heading_76eHDD":{"type":"heading","settings":{"title":"Custom-Carved Cowrie Shells","heading_tag":"h1","heading_font_class":"fs-heading-1-base"}},"text_zRfwTF":{"type":"text","settings":{"text":"<p>Our Custom Carved Cowrie Shells are a distinctive coastal souvenir designed specifically for wholesale partners. Each shell is hand-carved and customised with any location name, making them a versatile option for tourism operators, resorts, and gift shops. Motifs available include whales, dolphins, turtles, sailboats, crocodiles, crayfish, and coconut trees, offering a range that resonates strongly across coastal and destination markets. <\/p>","text_font_class":"fs-body-100"}}},"block_order":["heading_76eHDD","text_zRfwTF"],"name":"t:sections.rich_text.presets.name","settings":{"alignment":"center_center","enable_animation":true,"divider_style":"none","section_padding":"section--vertical-padding-top-bottom","content_width":"full","custom_content_width":700,"background_color":"#fefaf1","text_color":"#5c5451","cutsom_class":"mobile-large-heading ds-carved-shells heading-linehight"}},"image_hero_xraJ37":{"type":"image-hero","name":"t:sections.image_hero.presets.name","settings":{"image_aspect":"custom","desktop_height":50,"mobile_height":50,"image":"shopify:\/\/shop_images\/aac84d39459ec392993cfcd278732b8086b334e3.png","focal_point":"image_presentation","mobile_focal_point":"image_presentation","media_link":"","text_position":"center_center","text_position_mobile":"center_center","text_color":"#ffffff","button_background_color":"#ffffff","button_text_color":"#000000","color_overlay":"#000000","color_overlay_gradient":"","overlay_opacity":0,"enable_animation":true,"section_padding":"section--vertical-padding-none"}},"multi_column_WU6b8Y":{"type":"multi-column","blocks":{"column_FchN