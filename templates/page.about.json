,"text_font_class":"fs-body-100"}}},"block_order":["accent_CWxJR4","heading_pHXwML","text_UypFp9"],"disabled":true,"name":"t:sections.image_with_text_split.presets.name","settings":{"image_position":"left","image_mobile_position":"above-content","image_padding":"all-sides","image":"shopify:\/\/shop_images\/1994_2.jpg","aspect_ratio":"natural","focal_point":"image_presentation","content_alignment":"left","content_alignment_mobile":"center","background_color":"#f2ebe9","text_color":"#332e26","button_background_color":"#000000","button_text_color":"#ffffff","enable_animation":true,"section_padding":"section--vertical-padding-none","custom_class":"small-heading section section spacing-bottom-0 base-body-heading heading-black"}},"image_with_text_split_MBfnA3":{"type":"image-with-text-split","blocks":{"heading_WLrHRC":{"type":"heading","settings":{"title":"1999 — Scaling Up","heading_tag":"h2","heading_font_class":"fs-heading-1-base"}},"text_VwACjp":{"type":"text","settings":{"text":"<p>The business moves to South Windsor and acquires Australia’s largest botanical importer.<\/p>","text_font_class":"fs-body-100"}}},"block_order":["heading_WLrHRC","text_VwACjp"],"name":"t:sections.image_with_text_split.presets.name","settings":{"image_position":"left","image_mobile_position":"above-content","image_padding":"all-sides","image":"shopify:\/\/shop_images\/1999_d94b7978-9178-455e-9558-a0b4fa92ba8e.jpg","aspect_ratio":"natural","focal_point":"image_presentation","content_alignment":"left","content_alignment_mobile":"center","background_color":"#f2ebe9","text_color":"#332e26","button_background_color":"#000000","button_text_color":"#ffffff","enable_animation":true,"section_padding":"section--vertical-padding-none","custom_class":"small-heading section section spacing-bottom-0 base-body-heading heading-black"}},"image_with_text_split_yMRHaT":{"type":"image-with-text-split","blocks":{"heading_N3DkUX":{"type":"heading","settings":{"title":"2002–2004 — Investing in Innovation ","heading_tag":"h2","heading_font_class":"fs-heading-1-base"}},"text_BUAdmz":{"type":"text","settings":{"text":"<p>Pastel Pines secures land and builds a high-capacity factory at 30 Walker Street. Essential Oils and Reed Diffusers join the product line.<\/p>","text_font_class":"fs-body-100"}}},"block_order":["heading_N3DkUX","text_BUAdmz"],"name":"t:sections.image_with_text_split.presets.name","settings":{"image_position":"right","image_mobile_position":"above-content","image_padding":"all-sides","image":"shopify:\/\/shop_images\/2002_675b2640-fc83-4196-84ae-ace75961f43f.jpg","aspect_ratio":"natural","focal_point":"image_presentation","content_alignment":"left","content_alignment_mobile":"center","background_color":"#f2ebe9","text_color":"#332e26","button_background_color":"#000000","button_text_color":"#ffffff","enable_animation":true,"section_padding":"section--vertical-padding-none","custom_class":"small-heading section section spacing-bottom-0 base-body-heading heading-black"}},"image_with_text_split_epWVpF":{"type":"image-with-text-split","blocks":{"heading_hKGWPA":{"type":"heading","settings":{"title":"2006 — Full Ownership ","heading_tag":"h2","heading_font_class":"fs-heading-1-base"}},"text_gniAnU":{"type":"text","settings":{"text":"<p>Joan and Peter acquire 100% of Pastel Pines, setting the stage for continued innovation.<\/p>","text_font_class":"fs-body-100"}}},"block_order":["heading_hKGWPA","text_gniAnU"],"name":"t:sections.image_with_text_split.presets.name","settings":{"image_position":"left","image_mobile_position":"above-content","image_padding":"all-sides","image":"shopify:\/\/shop_images\/2006.jpg","aspect_ratio":"natural","focal_point":"image_presentation","content_alignment":"left","content_alignment_mobile":"center","background_color":"#f2ebe9","text_color":"#332e26","button_background_color":"#000000","button_text_color":"#ffffff","enable_animation":true,"section_padding":"section--vertical-padding-none","custom_class":"small-heading section spacing-bottom-0 base-body-heading heading-black"}},"image_with_text_split_dFFpUL":{"type":"image-with-text-split","blocks":{"heading_XeDVaP":{"type":"heading","settings":{"title":"2014 — Leadership Evolution","heading_tag":"h2","heading_font_class":"fs-heading-1-base"}},"text_rKMt73":{"type":"text","settings":{"text":"<p>Sam Maitland is appointed General Manager after 14 years of mentorship, bringing fresh energy to the brand.<\/p>","text_font_class":"fs-body-100"}}},"block_order":["heading_XeDVaP","text_rKMt73"],"name":"t:sections.image_with_text_split.presets.name","settings":{"image_position":"right","image_mobile_position":"above-content","image_padding":"all-sides","image":"shopify:\/\/shop_images\/2014_34dccf6e-aa78-4387-ad5f-d1b8feb34e9e.jpg","aspect_ratio":"natural","focal_point":"image_presentation","content_alignment":"left","content_alignment_mobile":"center","background_color":"#f2ebe9","text_color":"#332e26","button_background_color":"#000000","button_text_color":"#ffffff","enable_animation":true,"section_padding":"section--vertical-padding-none","custom_class":"small-heading section section spacing-bottom-0 base-body-heading heading-black"}},"image_with_text_split_tQBfNq":{"type":"image-with-text-split","blocks":{"heading_6pNNBe":{"type":"heading","settings":{"title":"2016 — Expanding Our Craft ","heading_tag":"h2","heading_font_class":"fs-heading-1-base"}},"text_gjpyJr":{"type":"text","settings":{"text":"<p>Candle manufacturing is introduced, expanding our Australian-made fragrance offering.<\/p>","text_font_class":"fs-body-100"}}},"block_order":["heading_6pNNBe","text_gjpyJr"],"name":"t:sections.image_with_text_split.presets.name","settings":{"image_position":"left","image_mobile_position":"above-content","image_padding":"all-sides","image":"shopify:\/\/shop_images\/2016.png","aspect_ratio":"natural","focal_point":"image_presentation","content_alignment":"left","content_alignment_mobile":"center","background_color":"#f2ebe9","text_color":"#332e26","button_ba