<style>
  @media (max-width: 959px) {
    .grid-only .featured-collection-grid__products {
      display: grid;
      grid-template-columns: repeat({{ section.settings.mobile_columns | default: 1 }}, 1fr);
      gap: 30px;
    }
  }
.section-introduction.align-left {
  text-align: left;
}

.section-introduction.align-center {
  text-align: center;
}

.section-introduction.align-right {
  text-align: right;
}

/* Button alignment */
.section-introduction.align-left .section-introduction__button {
  display: flex;
  justify-content: flex-start;
}

.section-introduction.align-center .section-introduction__button {
  display: flex;
  justify-content: center;
}

.section-introduction.align-right .section-introduction__button {
  display: flex;
  justify-content: flex-end;
}

</style>


{%- liquid
  assign max_products = section.settings.maximum_products

  capture custom_swatch_color_maps
    render 'get-custom-swatch-color-maps'
  endcapture

  assign custom_color_key_map = custom_swatch_color_maps | split: ' | ' | first | split: ','
  assign custom_color_value_map = custom_swatch_color_maps | split: ' | ' | last | split: ','
-%}

<div
  class="
    featured-collection-grid {{ section.settings.custom_class }}
    featured-collection-grid--rows-{{ section.settings.rows }}
    featured-collection-grid--per-view-{{ section.settings.columns }}
    section--includes-product-items
    section--divider-{{ section.settings.divider_style }}
    {{ section.settings.section_padding }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--featured-collection-grid
    {% endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="featured-collection-grid"
  data-layout-type="grid"
  data-products-per-view="{{ section.settings.columns }}"
  data-mobile-products-per-view="{{ section.settings.mobile_columns }}"
  style="
  --section-bg: {{ section.settings.background_color }};
  --section-text: {{ section.settings.text_color }};
"

>
  <div class="section">
  <div class="featured-collection-grid__inner">
  <div class="section-introduction animation--section-introduction align-{{ section.settings.heading_alignment }}">
        {%- unless section.settings.heading == blank -%}
          <{{ section.settings.heading_tag }} class="featured-collection-grid__heading ff-heading fs-heading-3-base section-introduction__heading">
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {%- endunless -%}

        {%- unless section.settings.subheading == blank -%}
          <div class="featured-collection-grid__subheading ff-body fs-body-100 rte section-introduction__subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endunless -%}

  
  </div>
<div
  class="
    featured-collection-grid__content
    {% if section.settings.enable_mobile_carousel %}
      carousel carousel--mobile-per-view-{{ section.settings.mobile_columns }} swiper
    {% else %}
      grid-only
    {% endif %}
  "
>
    {% comment %} <div
      class="
        featured-collection-grid__content
        carousel
        carousel--mobile-per-view-{{ section.settings.mobile_columns }}
        carousel--per-view-{{ section.settings.columns }}
        swiper
      "
    > {% endcomment %}
      {% comment %} <div class="featured-collection-grid__products carousel__wrapper swiper-wrapper"> {% endcomment %}
       <div class="featured-collection-grid__products
        {% if section.settings.enable_mobile_carousel %}
          carousel__wrapper swiper-wrapper
        {% endif %}
      ">

        {%- for block in section.blocks -%}
          {%- assign featured_collection_products = block.settings.collection.products
            | default: block.settings.product_list
          -%}

          {%- for product in featured_collection_products limit: max_products -%}
                <div class="featured-collection-grid__product
                  {% if section.settings.enable_mobile_carousel %}
                    carousel_slide swiper-slide
                  {% endif %}
                ">              
                {% render 'product-item',
                prod: product,
                collection: block.settings.collection,
                aspect_ratio: settings.product_listing_aspect_ratio,
                product_columns: section.settings.columns,
                custom_color_key_map: custom_color_key_map,
                custom_color_value_map: custom_color_value_map
              %}
            </div>
          {%- else -%}
            {%- for i in (1..max_products) -%}
                  <div class="featured-collection-grid__product
                    {% if section.settings.enable_mobile_carousel %}
                      carousel_slide swiper-slide
                    {% endif %}
                  ">          
                  {% render 'product-item',
                  aspect_ratio: settings.product_listing_aspect_ratio,
                  product_columns: section.settings.columns,
                  placeholder: true,
                  custom_color_key_map: custom_color_key_map,
                  custom_color_value_map: custom_color_value_map
                %}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..max_products) -%}
                <div class="featured-collection-grid__product
                  {% if section.settings.enable_mobile_carousel %}
                    carousel_slide swiper-slide
                  {% endif %}
                ">              
                {% render 'product-item',
                aspect_ratio: settings.product_listing_aspect_ratio,
                product_columns: section.settings.columns,
                placeholder: true,
                custom_color_key_map: custom_color_key_map,
                custom_color_value_map: custom_color_value_map
              %}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  
<div class="section-introduction animation--section-introduction align-{{ section.settings.heading_alignment }}">
      {%- render 'button-block',
        wrapper_class: 'featured-collection-grid__button section-introduction__button',
        link: section.settings.link,
        label: section.settings.link_text,
        button_style: section.settings.button_style
      -%}
</div>
</div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection_grid.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ],
    "templates": [
      "password"
    ]
  },
  "settings": [
     {
      "type": "header",
      "content": "t:sections.shared.media_with_text.settings.color.header.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:shared.settings.color.general.background.label",
      "default": "#D9A49C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:shared.settings.color.general.text.label",
      "default": "#000000"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shared.collections.settings.title.label",
      "default": "t:sections.featured_collection_grid.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:shared.settings.heading_tag.heading.label",
      "options": [
        {
          "value": "h2",
          "label": "t:shared.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:shared.settings.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:shared.settings.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:shared.settings.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:shared.settings.heading_tag.options.h6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.heading_tag.heading.info"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.shared.collections.settings.subheading.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:shared.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:shared.settings.button_link_text.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:shared.settings.button_style.label",
      "options": [
        {
          "value": "btn--primary",
          "label": "t:shared.settings.button_style.options.solid"
        },
        {
          "value": "btn--secondary",
          "label": "t:shared.settings.button_style.options.outline"
        },
        {
          "value": "btn--callout",
          "label": "t:shared.settings.button_style.options.text"
        }
      ],
      "default": "btn--callout"
    },
    {
      "type": "header",
      "content": "t:sections.shared.collections.settings.product_list.header.content"
    },
    {
      "type": "range",
      "id": "maximum_products",
      "label": "t:sections.shared.collections.settings.product_list.maximum_products.label",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:shared.settings.column_count.desktop.label",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:shared.settings.column_count.mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
  "type": "checkbox",
  "id": "enable_mobile_carousel",
  "label": "Enable carousel on mobile",
  "default": true
},
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header.content"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true,
      "info": "t:shared.settings.section_style.enable_animation.info"
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:shared.settings.section_style.divider_style.options.none"
        },
        {
          "value": "solid",
          "label": "t:shared.settings.section_style.divider_style.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "t:shared.settings.section_style.section_padding.label",
      "options": [
        {
          "value": "section--vertical-padding-none",
          "label": "t:shared.settings.section_style.section_padding.options.none"
        },
        {
          "value": "section--vertical-padding-top-bottom",
          "label": "t:shared.settings.section_style.section_padding.options.both"
        },
        {
          "value": "section--vertical-padding-top-only",
          "label": "t:shared.settings.section_style.section_padding.options.top"
        },
        {
          "value": "section--vertical-padding-bottom-only",
          "label": "t:shared.settings.section_style.section_padding.options.bottom"
        }
      ],
      "default": "section--vertical-padding-top-bottom"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.featured_collection_grid.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.shared.collections.settings.collection.label"
        }
      ]
    },
    {
      "type": "product_list",
      "name": "t:sections.featured_collection_grid.blocks.product_list.name",
      "settings": [
        {
          "type": "product_list",
          "id": "product_list",
          "label": "t:sections.shared.collections.settings.product_list.label"
        }
      ]
    }
  ],
  "max_blocks": 1,
  "presets": [
    {
      "name": "t:sections.featured_collection_grid.presets.name",
      "blocks": [
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
